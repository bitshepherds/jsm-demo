{
  "$schema": "https://raw.githubusercontent.com/bitshepherds/sheepdog/main/schemas/settings_repo_5_0_0.schema.json",
  "repo": "bitshepherds/jsm-demo",
  "install": "bun install",
  "gate": "make check",
  "prTitleGate": "grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|deps)(\\(.*\\))?!?: .+'",
  "safetyNet": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.*",
    "**/test_*.py",
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/*.feature",
    ".github/workflows/**",
    ".gitlab-ci.yml",
    ".husky/**",
    "lefthook.yml",
    ".pre-commit-config.yaml",
    ".sheepdog/settings.json",
    ".sheepdog/review.md",
    "**/CODEOWNERS",
    ".github/rulesets/**",
    "**/biome.json",
    "**/biome.jsonc",
    "**/.eslintrc*",
    "**/eslint.config.*",
    "**/.prettierrc*",
    "**/ruff.toml",
    "**/.golangci.yml",
    "**/bunfig.toml",
    "**/vitest.config.*",
    "**/jest.config.*",
    "**/pytest.ini",
    "**/.mocharc*",
    "**/coverage-baseline.json",
    "**/pass/*.json",
    "**/fail/*.json",
    "**/.markdownlint*",
    "**/json-schema-manager-config.yml",
    "**/family.yml",
    "**/compat-exceptions.yml"
  ],
  "criticalPaths": [
    ".github/workflows/**",
    "**/json-schema-manager-config.yml",
    "**/family.yml",
    "**/compat-exceptions.yml"
  ],
  "practices": {
    "off": {
      "suite-health": "jsm validate has no way to run its tests in random order with a given seed"
    }
  },
  "stance": "balanced",
  "survey": {
    "scripts": "d35c46d378f3",
    "workspaces": "4f53cda18c2b",
    "makeTargets": "df6b2ef75624",
    "ci": "ae8941bae1bc",
    "hooks": "2485ba485215",
    "lockfiles": "448be305bc1c",
    "commitlint": "4f53cda18c2b",
    "toolchain": "4f53cda18c2b"
  },
  "ciTime": {
    "job": "check"
  }
}
