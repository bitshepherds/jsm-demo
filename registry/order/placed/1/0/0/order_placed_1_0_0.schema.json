{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "title": "Order placed event",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "total": { "type": "number", "minimum": 0 },
    "currency": { "type": "string" }
  },
  "required": ["orderId", "total"]
}
