{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "title": "Synced note",
  "description": "A note, as one install of the app syncs it to the others on the same account.",
  "type": "object",
  "properties": {
    "noteId": { "type": "string" },
    "text": { "type": "string" },
    "state": { "enum": ["active", "archived"] },
    "updatedAt": { "type": "string" }
  },
  "required": ["noteId", "text", "state"]
}
