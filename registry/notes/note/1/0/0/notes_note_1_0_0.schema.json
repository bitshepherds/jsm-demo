{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{ ID }}",
  "title": "Synced note",
  "type": "object",
  "properties": {
    "noteId": { "type": "string" },
    "text": { "type": "string" },
    "state": { "enum": ["active", "archived"] },
    "updatedAt": { "type": "string" }
  },
  "required": ["noteId", "text", "state"]
}
